# GSD planning artifacts (internal workflow, not for public repo)
.planning/

# Go binary
toolbox

# Coverage profile: produced by the SonarQube workflow and by any local
# `go test -coverprofile`, consumed by the scanner, never committed.
coverage.out

# Per-developer toolbox config override
.toolbox.yaml

# GoReleaser
dist/

# Claude Code local settings
.claude/settings.local.json
.claude/worktrees/

# Session handoff notes written between context resets (per-developer scratch)
.mode-router/

# Local architecture review reports (per-developer scratch, not team-shared)
.architecture-reviews/

# macOS
.DS_Store

# graphify: local-only knowledge graph artifacts. Aligned with upstream
# .gitignore at https://github.com/safishamsi/graphify/blob/v8/.gitignore —
# the whole graphify-out/ tree is per-developer scratch, regenerated on
# every branch switch / `/graphify` invocation. Not team-shared.
graphify-out/
# `graphify install` drops this backup beside the settings it patched. Nothing
# reads it back; init.d/30-graphify.sh removes it, this is the belt-and-braces
# half for anyone running graphify install by hand.
.claude/settings.json.graphify-bak
# `graphify install --project --platform claude` regenerates this whole skill
# dir (SKILL.md, references/, .graphify_version) on every version bump, so
# tracking it only adds diff noise. init.d/30-graphify.sh installs it in the
# container; the version stamp is write-only in project scope.
.claude/skills/graphify/
docs/superpowers/specs/
docs/superpowers/plans/

# Local design proposal (not ready for upstream)
openspec/changes/add-loopback-bridge/

# OpenSpec working tree (local-only, not shared)
openspec/

# Per-repo toolbox runtime dir (binary + startup.d/*)
.toolbox/

