#!/bin/sh
# toolbox bridge git credential helper. git cannot reach the host's credential
# store (macOS Keychain, Linux secret-service) from inside the container, so
# this shim forwards the git credential protocol to the host daemon's
# /credential endpoint, where `git credential fill|approve|reject` delegates to
# whatever credential.helper the host is configured with. Registered as
# `credential.helper !git-credential-toolbox` in the container's system
# gitconfig by entrypoint.sh, gated on the bridge being installed.
#
# git invokes it as `git-credential-toolbox <get|store|erase>` and writes the
# credential request on stdin. Like xdg-open (and unlike code/proximo), it
# ALWAYS exits 0: a missing/unreachable bridge must degrade to git's normal
# interactive prompt, never abort the clone. For `get` it prints the host's
# username/password lines; for store/erase git ignores the output.

set -eu

. /usr/local/lib/toolbox/bridge-lib.sh

# git always passes exactly one operation argument. Anything else: stay silent
# and let git carry on (exit 0, no output).
[ "$#" -eq 1 ] || exit 0
OP="$1"

# Opt-out honored via the standard env: passthrough — set GIT_CREDENTIAL_BRIDGE=0
# in .toolbox.yaml to disable forwarding even when the bridge is installed. The
# name is deliberately un-prefixed: config ValidateEnv reserves the TOOLBOX_
# prefix for the curated env contract, so a TOOLBOX_* opt-out couldn't be set
# via env: at all.
case "${GIT_CREDENTIAL_BRIDGE:-}" in
0 | false | no | off) exit 0 ;;
esac

# No bridge / no curl → behave as if no helper is configured.
bridge_ready || exit 0

# python3 encodes/decodes the JSON below and is baked into the image; guard
# anyway so a hypothetically stripped image degrades to a git prompt (exit 0)
# instead of aborting the clone under `set -eu`.
command -v python3 >/dev/null 2>&1 || exit 0

# Read the full credential request from stdin and JSON-encode {op, input}. The
# input carries newlines and `=`, so encode via python3 (as bin/code does for
# paths) rather than hand-rolling escaping.
PAYLOAD=$(OP="${OP}" python3 -c '
import json, os, sys
print(json.dumps({"op": os.environ["OP"], "input": sys.stdin.read()}))
')

BODY_FILE=$(mktemp)
trap 'rm -f "${BODY_FILE}"' EXIT

STATUS=$(bridge_post /credential "${PAYLOAD}" "${BODY_FILE}" 65)

# Only a successful exchange yields output to hand back to git. Any other
# status (404 old daemon, 000 bridge down, 4xx/5xx) degrades silently to a
# prompt.
case "${STATUS}" in
2??)
    BODY_FILE="${BODY_FILE}" python3 -c '
import json, os, sys
with open(os.environ["BODY_FILE"]) as f:
    resp = json.load(f)
sys.stdout.write(resp.get("output", ""))
'
    ;;
esac

exit 0
