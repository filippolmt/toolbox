#!/bin/sh
# toolbox proximo /etc/hosts sync.
#
# proximo routes *.<tld> apps on the HOST via a wildcard resolver, which maps
# them to host loopback. That address is wrong inside a toolbox container, so
# this command owns the complete route projection into its network namespace:
# it reads proximo's effective-route inventory from its read-only bind and
# rewrites a managed block in /etc/hosts, pinning every bare and qualified name
# to the host-gateway. For an older proximo without that inventory it falls back
# to labels from the host Docker daemon. /etc/hosts is mutable at runtime, so
# reachability tracks the running stacks without recreating the container.
#
# Usage:
#   proximo-hosts            sync once and exit (idempotent)
#   proximo-hosts --watch    sync, then follow inventory replacements (or
#                            Docker events on the legacy label fallback).
#                            entrypoint.sh launches this automatically.

set -eu

BEGIN_MARKER="# >>> toolbox proximo (managed) >>>"
END_MARKER="# <<< toolbox proximo (managed) <<<"
HOSTS_FILE="${TOOLBOX_HOSTS_FILE:-/etc/hosts}"
INVENTORY_DIR="${TOOLBOX_PROXIMO_INVENTORY_DIR:-/etc/toolbox/proximo}"
INVENTORY_FILE="${INVENTORY_DIR}/routes.json"

note() { echo "proximo-hosts: $1" >&2; }

# host-gateway IP: the host.docker.internal entry (pinned at create unless
# `bridge: false`), else the default-route gateway (docker0) so the sync still
# works without that pin. Both resolve to the same host-gateway. IPv4 is forced
# (ahostsv4 / `ip -4`): Traefik publishes :443 on IPv4, and host.docker.internal
# can resolve IPv6-first on some Docker setups.
gateway_ip() {
    _gw=$(getent ahostsv4 host.docker.internal 2>/dev/null | awk '{print $1; exit}')
    if [ -n "${_gw:-}" ]; then
        printf '%s' "${_gw}"
    elif command -v ip >/dev/null 2>&1; then
        ip -4 route show default 2>/dev/null | awk '{print $3; exit}'
    fi
}

inventory_hosts() {
    command -v python3 >/dev/null 2>&1 || { note "python3 missing in image"; return 1; }
    python3 - "${INVENTORY_FILE}" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    routes = json.load(source).get("routes", [])
hosts = set()
for route in routes:
    for key in ("bare", "qualified"):
        value = route.get(key)
        if isinstance(value, str) and value:
            hosts.add(value)
print("\n".join(sorted(hosts)))
PY
}

label_hosts() {
    command -v docker >/dev/null 2>&1 || { note "docker CLI missing in image"; return 1; }
    _ids=$(docker ps --filter 'label=proximo.hosts' --quiet 2>/dev/null) ||
        { note "docker ps failed — is /var/run/docker.sock mounted?"; return 1; }
    _raw=""
    if [ -n "${_ids}" ]; then
        # shellcheck disable=SC2086  # word-split the newline-separated ID list
        _raw=$(docker inspect --format '{{index .Config.Labels "proximo.hosts"}}' ${_ids} 2>/dev/null) ||
            { note "docker inspect failed"; return 1; }
    fi
    printf '%s\n' "${_raw}" |
        tr ',' '\n' |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//' |
        grep -v '^$' |
        sort -u
}

discover_hosts() {
    if [ -f "${INVENTORY_FILE}" ]; then
        inventory_hosts
    else
        label_hosts
    fi
}

# run_sync rewrites the managed /etc/hosts block from proximo's effective-route
# inventory, falling back to proximo.hosts labels for an older installation.
# Returns non-zero on a recoverable error rather than touching the current block.
run_sync() {
    _gw=$(gateway_ip)
    [ -n "${_gw:-}" ] || { note "cannot determine host-gateway IP"; return 1; }

    _hosts=$(discover_hosts) || { note "cannot read routed hosts"; return 1; }

    # Build the candidate /etc/hosts: strip any prior managed block, then append
    # a fresh one. The markers are emitted even when no host is routed, so a
    # brought-down stack clears its previous pins.
    _tmp=$(mktemp)
    sed "/^${BEGIN_MARKER}\$/,/^${END_MARKER}\$/d" "${HOSTS_FILE}" >"${_tmp}"
    {
        printf '%s\n' "${BEGIN_MARKER}"
        for _h in ${_hosts}; do
            printf '%s\t%s\n' "${_gw}" "${_h}"
        done
        printf '%s\n' "${END_MARKER}"
    } >>"${_tmp}"

    # Skip the privileged write when nothing changed: a compose up/down fires one
    # event per container, but the managed block usually changes at most once, so
    # this keeps the event burst cheap (no sudo, no log spam).
    if cmp -s "${_tmp}" "${HOSTS_FILE}"; then
        rm -f "${_tmp}"
        return 0
    fi

    # /etc/hosts is root-owned; sudo is passwordless + UID-agnostic.
    if ! sudo cp "${_tmp}" "${HOSTS_FILE}"; then
        rm -f "${_tmp}"
        note "failed to write ${HOSTS_FILE} (sudo)"
        return 1
    fi
    rm -f "${_tmp}"

    _count=$(printf '%s\n' "${_hosts}" | grep -c . || true)
    note "pinned ${_count} host(s) -> ${_gw}"
}

case "${1:-}" in
"")
    run_sync
    ;;
--watch)
    run_sync || true
    if [ -d "${INVENTORY_DIR}" ]; then
        # The inventory is atomically replaced, so polling the document avoids
        # racing proximo's watcher on the Docker event that caused the change.
        while :; do
            sleep 2
            run_sync || true
        done
    fi
    # Compatibility path for a proximo predating the mounted inventory.
    while :; do
        docker events \
            --filter 'label=proximo.hosts' \
            --filter 'event=start' \
            --filter 'event=die' \
            --format '{{.Time}}' 2>/dev/null |
            while IFS= read -r _; do
                run_sync || true
            done
        sleep 2
    done
    ;;
*)
    note "usage: proximo-hosts [--watch]"
    exit 2
    ;;
esac
