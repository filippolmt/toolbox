#!/bin/sh
# git-prune-dead — delete local branches whose work is finished, and only
# those.
#
# "Finished" means the forge says the branch's PR/MR was merged. It cannot mean
# "the upstream is gone": a squash merge never makes the branch's commits
# reachable from the default branch, so locally an abandoned branch and a
# squash-merged one look identical — both simply lose their remote. Deleting on
# a gone upstream alone therefore throws away the only copy of unmerged work,
# which is why every deletion below needs positive proof of a merge — and the
# proof has to cover the local tip: the merged PR's head is the tip, or contains
# it.
#
# The forge CLI is picked by asking which one is authenticated for origin's
# host, so github.com, gitlab.com, GitHub Enterprise and a self-hosted GitLab
# all resolve without special-casing any domain. A host neither CLI holds a
# session for is asked whether it runs Forgejo, whose API answers over curl.
# No forge to ask, an unreachable one, or a PR that was closed without
# merging → the branch is kept and the reason printed. Never deleted either:
# the current branch and the repository's default branch.
#
# The one local proof is still honoured: worktree-agent-* leftovers actually
# merged into the default branch are deleted without asking the forge.
#
# Invoke as `git prune-dead` — git resolves any `git-*` on PATH as a subcommand.
set -u

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
	echo "git-prune-dead: not inside a git repository" >&2
	exit 1
}

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

# Host and owner/repo of origin, from either URL form: scheme://[user@]host/path
# or the scp shorthand [user@]host:path. The repo is passed to the forge CLI
# explicitly, because gh otherwise resolves its own repo from whichever remote
# it prefers (an `upstream` on a fork clone) — a different repository from the
# one whose host we just checked for a session.
origin_url=$(git remote get-url origin 2>/dev/null || true)

# parse_url <url> — set url_form, bare_url, host and slug from either
# URL form. git reads the scp shorthand only when a colon comes before any
# slash; any other URL without a scheme is a local path, with no host and no
# forge to ask.
parse_url() {
	host=
	slug=
	case $1 in
	*://*) url_form=scheme ;;
	*) case ${1%%/*} in
		*:*) url_form=scp ;;
		*) url_form=local ;;
		esac ;;
	esac
	[ "$url_form" = local ] && return
	bare_url=$(printf '%s\n' "$1" |
		sed -e 's#^[A-Za-z0-9+.-]*://##' -e 's#^[^/@]*@##')
	# A bracketed IPv6 literal keeps its colons; any other host ends at the
	# first ":" or "/".
	case $bare_url in
	'['*) host="${bare_url%%]*}]" ;;
	*) host=$(printf '%s\n' "$bare_url" | sed 's#[:/].*$##') ;;
	esac
	# After the host: the scheme form may carry a :port before its first "/";
	# the scp form has no port, just the ":". Leading and trailing slashes and
	# a .git suffix spell the same repository.
	rest=${bare_url#"$host"}
	case $url_form in
	scheme) rest=${rest#*/} ;;
	scp) rest=${rest#:} ;;
	esac
	slug=$(printf '%s\n' "$rest" | sed -e 's#^/*##' -e 's#/*$##' -e 's#\.git$##')
}
parse_url "$origin_url"

# forgejo_get <url> — GET from the Forgejo API, the credential (if any) on
# stdin. -q first: a ~/.curlrc must not redirect or re-authenticate this.
forgejo_get() {
	req_url=$1
	set -- -q -fsS --connect-timeout 5 -m 20 --config -
	[ -n "$forgejo_ca" ] && set -- "$@" --cacert "$forgejo_ca"
	printf '%s\n' "$forgejo_curl_cfg" | curl "$@" "$req_url" 2>/dev/null
}

# curl_quote <value> — a curl config value, double-quoted: \ and " escaped,
# and line breaks dropped so the value cannot start a config line of its own.
curl_quote() {
	printf '"%s"' "$(printf '%s' "$1" | tr -d '\r\n' | sed 's/[\\"]/\\&/g')"
}

# forgejo_merged_heads <branch> — the same JSON array of merged same-repo
# heads gh and glab produce, or "live" when the only merged PRs it found still
# have their branch on the server. head= filters only from Forgejo v16 — an
# older server ignores it and lists every closed PR — so the filter is redone
# here: merged, from this branch (head.label), from this repository (a fork's
# or a deleted head repository's id differs from base's), and with the branch
# deleted on the server (head.ref then reads refs/pull/N/head and head.sha is
# the head that was merged; while the branch lives, head.sha is its current
# tip, commits after the merge included). Every page must be a JSON array —
# anything else is a failure, never an empty answer — and since an instance
# caps limit at its own maximum, only an empty page ends the list.
# shortcut: 100 pages at most, then unverified, raise the cap if a pre-v16
# server with more than 5000 closed PRs keeps its branches unverified.
forgejo_merged_heads() {
	head_param=$(jq -rn --arg b "$1" '$b | @uri') || return 1
	page_no=1
	page_heads=
	live=0
	while [ "$page_no" -le 100 ]; do
		resp=$(forgejo_get "$forgejo_api/repos/$forgejo_slug/pulls?state=closed&head=$head_param&limit=50&page=$page_no") || return 1
		page_len=$(printf '%s' "$resp" | jq -e 'if type == "array" then length else error end' 2>/dev/null) || return 1
		if [ "$page_len" = 0 ]; then
			heads=$(printf '%s\n' "$page_heads" | jq -sc 'add // []') || return 1
			if [ "$heads" = "[]" ] && [ "$live" -gt 0 ]; then
				echo live
			else
				printf '%s\n' "$heads"
			fi
			return
		fi
		# Merged PRs of this branch from this repository; .live counts those
		# whose branch is still on the server.
		page=$(printf '%s' "$resp" | jq -c --arg b "$1" '
			[.[] | select(.merged == true and .head.label == $b and .head.repo_id > 0 and .head.repo_id == .base.repo_id)]
			| {heads: [.[] | select(.head.ref | startswith("refs/pull/")) | .head.sha],
			   live: [.[] | select(.head.ref | startswith("refs/pull/") | not)] | length}') || return 1
		page_heads="$page_heads$(printf '%s' "$page" | jq -c .heads) "
		live=$((live + $(printf '%s' "$page" | jq .live)))
		page_no=$((page_no + 1))
	done
	return 1
}

# The forge CLI is whichever one holds a session for that host — the question
# "which forge is this?" and "can I ask it anything?" have the same answer, so
# they are resolved together, once, rather than per branch.
forge=
if [ -n "$host" ]; then
	for cli in gh glab; do
		if command -v "$cli" >/dev/null 2>&1 &&
			"$cli" auth status --hostname "$host" >/dev/null 2>&1; then
			forge=$cli
			break
		fi
	done
fi

# Forgejo has no CLI session to find; its API is asked on the origin's own
# scheme and port when it is an http(s) URL, over HTTPS on the default port
# otherwise, an SSH port being no web one. Only a JSON version answer marks the
# host as Forgejo: a catch-all web front answers 200 to any path. The probe
# goes out bare; an instance with REQUIRE_SIGNIN_VIEW refuses that, so a bare
# probe that fails — on any host, Forgejo or not — is retried with the
# credential git itself sends to that URL: scoped to that host by git's
# credential helpers, unlike any environment token, and only over https,
# never in clear text. That credential is asked for without a
# prompt, on the host too: GCM_INTERACTIVE=never reaches the bridge shim as
# no_prompt, and internal/bridge/credential.go silences the host helpers the
# way the flags below silence the container's. It reaches curl on stdin: on
# argv it would show in ps. None at all still reads a public repository. TLS
# trusts what git trusts for that URL: a self-hosted instance's private CA
# sits in http.<url>.sslCAInfo.
# A Forgejo repository path is always owner/repo, so in an http(s) origin
# whatever precedes those two segments is the instance's web root — an
# instance served under a sub-path (https://host/forgejo/owner/repo) is asked
# there.
# shortcut: an SSH origin carries no web root, so a sub-path instance reached
# over SSH is not found, add a per-host setting if one turns up.
forgejo_api=
forgejo_slug=$slug
forgejo_ca=
forgejo_curl_cfg=
have_forgejo_tools=
command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && have_forgejo_tools=1

# forgejo_answers — the host's version endpoint names a Forgejo version.
forgejo_answers() {
	forgejo_get "$web/api/forgejo/v1/version" | jq -e '.version | type == "string"' >/dev/null 2>&1
}

# forgejo_load_credential — set forgejo_curl_cfg from what git would send to
# $web; false, and nothing set, over plain http or with no credential.
forgejo_load_credential() {
	case $web in https://*) ;; *) return 1 ;; esac
	cred=$(printf 'url=%s\n\n' "$web" |
		GIT_ASKPASS='' SSH_ASKPASS='' GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
			git -c core.askPass= -c credential.interactive=false credential fill 2>/dev/null || true)
	cred_user=$(printf '%s\n' "$cred" | sed -n 's/^username=//p')
	cred_pass=$(printf '%s\n' "$cred" | sed -n 's/^password=//p')
	unset cred
	if [ -n "$cred_user" ] && [ -n "$cred_pass" ]; then
		forgejo_curl_cfg="user = $(curl_quote "$cred_user:$cred_pass")"
	fi
	unset cred_user cred_pass
	[ -n "$forgejo_curl_cfg" ]
}

if [ -z "$forge" ] && [ -n "$host" ] && [ -n "$have_forgejo_tools" ]; then
	case $origin_url in
	http://* | https://*)
		web="${origin_url%%://*}://${bare_url%%/*}"
		web_root=${slug%/*/*}
		if [ "$web_root" != "$slug" ]; then
			web="$web/$web_root"
			forgejo_slug=${slug#"$web_root"/}
		fi
		;;
	*) web="https://$host" ;;
	esac
	forgejo_ca=$(git config --get-urlmatch http.sslcainfo "$web/" 2>/dev/null || true)
	if forgejo_answers; then
		forge=forgejo
		forgejo_load_credential || true
	elif forgejo_load_credential && forgejo_answers; then
		forge=forgejo
	else
		forgejo_curl_cfg=
	fi
	[ "$forge" = forgejo ] && forgejo_api="$web/api/v1"
fi

# merge_state <branch> — 0 merged with the local tip covered, 1 no merged PR,
# 2 could not tell, 3 merged but the local tip is not covered, 4 a merged PR
# came back without a head, so whether it covers the tip is unknown, 5 merged
# on Forgejo with the branch still on the server, whose head is then its
# current tip rather than what was merged. Every
# forge answers with a JSON array of the merged heads, so "[]" is the one shape
# that means "no match"; anything else, including a failure, must never be
# read as "not merged".
#
# A merged PR proves that its head was merged, not that the local branch was:
# commits made after the merge, or a name reused after an older merged PR,
# leave a tip the merge never saw. So the tip must be a merged head or an
# ancestor of one (more was pushed to the PR from elsewhere): every local commit
# is then part of what was merged. A head absent locally and different from
# the tip matches nothing, and is never fetched — not even lazily, by a partial
# clone's promisor remote. A merged PR whose answer has no head proves nothing
# either way — it might be the one that covers the tip — so when no head
# covers it and any PR came back headless, the state is unverified (4), told
# apart from a forge that could not answer at all (2).
#
# The filters exist to reject a merge that happened on a *fork*: no forge
# scopes its branch filter to the head repository, so `--head fix` on a fork
# workflow matches a stranger's same-named branch — measured on cli/cli, where
# one branch name returned merged PRs from 30 different owners. Taking that as
# proof would force-delete local work, the exact failure this script prevents.
# Each filter is written to exclude rather than include, so a field the forge
# stops sending drops the branch out of the merged set instead of into it.
merge_state() {
	case "$forge" in
	gh) out=$(gh pr list --repo "$host/$slug" --head "$1" --state merged \
		--json headRefOid,isCrossRepository \
		--jq '[.[] | select(.isCrossRepository == false) | .headRefOid]' 2>/dev/null) || return 2 ;;
	glab) out=$(glab mr list --repo "https://$host/$slug" --source-branch "$1" --merged --output json \
		--jq '[.[] | select(.source_project_id != null and .source_project_id == .project_id) | .sha]' 2>/dev/null) || return 2 ;;
	forgejo)
		out=$(forgejo_merged_heads "$1") || return 2
		[ "$out" = live ] && return 5
		;;
	*) return 2 ;;
	esac
	case "$(printf '%s' "$out" | tr -d ' \n\r\t')" in
	"" | "[]") return 1 ;;
	esac
	# Fails only if the branch vanished since for-each-ref listed it: nothing
	# left to delete, so the catch-all "unverified" is as far as it goes.
	tip=$(git rev-parse --verify --quiet "refs/heads/$1") || return 2
	heads=$(printf '%s' "$out" | grep -oE '[0-9a-f]{40,64}') || return 4
	for head in $heads; do
		[ "$head" = "$tip" ] && return 0
		GIT_NO_LAZY_FETCH=1 git merge-base --is-ancestor "$tip" "$head" 2>/dev/null && return 0
	done
	case "$out" in
	*null* | *'""'*) return 4 ;;
	esac
	return 3
}

delete_branch() {
	# Skip the default and current branches; tolerate a refusal (e.g. the
	# branch is checked out in another worktree) without aborting the run.
	[ "$1" = "$default" ] && return 0
	[ "$1" = "$current" ] && return 0
	if git branch -D "$1" >/dev/null 2>&1; then
		echo "  deleted $1"
	fi
}

if [ -n "$(git remote)" ]; then
	echo "git-prune-dead: fetching + pruning remote refs..."
	# stderr is left alone: a failed prune is exactly what stops upstreams from
	# reading [gone], so the reason has to reach the user.
	git fetch --prune --quiet ||
		echo "git-prune-dead: fetch failed — working from the refs already local"
else
	echo "git-prune-dead: no remote configured — skipping fetch"
fi

# Default branch from origin/HEAD (set by `git remote set-head`), read only
# after the fetch: its --prune can remove the branch origin/HEAD names, and
# set-head alone refreshes the symref. The default is a local branch name,
# the one the guards below compare against. When origin/HEAD is unset,
# dangling or names no local branch, fall back to whichever of main/master
# exists locally, then to the current branch — so we never compare against a
# non-existent ref. merged_into is what the worktree-agent-* sweep measures
# against: the remote default itself when only origin has it, else the local
# default.
default=
merged_into=
if git rev-parse --verify --quiet refs/remotes/origin/HEAD >/dev/null; then
	default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
	if ! git show-ref --verify --quiet "refs/heads/$default"; then
		merged_into=refs/remotes/origin/HEAD
		default=
	fi
fi
if [ -z "$default" ]; then
	for cand in main master; do
		if git show-ref --verify --quiet "refs/heads/$cand"; then
			default=$cand
			break
		fi
	done
fi
[ -n "$default" ] || default=$current
[ -n "$merged_into" ] || merged_into=$default

if [ -n "$forge" ]; then
	echo "git-prune-dead: removing branches merged according to $forge on $host..."
elif [ -n "$origin_url" ] && [ -z "$host" ]; then
	echo "git-prune-dead: origin is a local path — no forge to ask, keeping every branch"
else
	echo "git-prune-dead: no CLI logged in to '${host:-no remote}' — keeping every branch"
	echo "  a gone upstream does not prove a merge; log in with: gh auth login --hostname ${host:-HOST}"
	echo "  or, on a GitLab instance: glab auth login --hostname ${host:-HOST}"
	if [ -n "$have_forgejo_tools" ]; then
		echo "  or, on a Forgejo instance: its API must answer /api/forgejo/v1/version on ${host:-HOST}"
	else
		echo "  or, on a Forgejo instance: install curl and jq, which its API is asked with"
	fi
fi

git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/ |
	while read -r name track; do
		[ "$track" = "[gone]" ] || continue
		[ "$name" = "$default" ] && continue
		[ "$name" = "$current" ] && continue
		merge_state "$name"
		case $? in
		0) delete_branch "$name" ;;
		1) echo "  kept $name (no merged PR on $forge — closed, or never opened)" ;;
		3) echo "  kept $name (no merged PR on $forge contains its tip — commits after the merge, a reused name, or a merged head not fetched here)" ;;
		4) echo "  kept $name (merge state unverified — a merged PR on $forge reports no head)" ;;
		5) echo "  kept $name (merged on $forge, but its branch still exists there — delete it on the server, then run again)" ;;
		# Named even with no forge to ask: a branch that survives silently reads
		# as one that was pruned.
		*) echo "  kept $name (merge state unverified${forge:+ — $forge could not answer})" ;;
		esac
	done

# Only meaningful when a default branch could be resolved; skip otherwise so
# we never run `git branch --merged ''`.
if [ -n "$merged_into" ]; then
	echo "git-prune-dead: removing merged worktree-agent-* leftovers..."
	git branch --merged "$merged_into" --format='%(refname:short)' |
		grep '^worktree-agent-' |
		while read -r name; do
			delete_branch "$name"
		done
fi

git worktree prune

kept="kept $default"
[ -n "$current" ] && [ "$current" != "$default" ] && kept="$kept, current $current"
echo "git-prune-dead: done ($kept)"
