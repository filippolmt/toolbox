#!/bin/sh
# git-prune-dead — delete local branches whose work is finished, and only
# those.
#
# "Finished" means the forge says the branch's PR/MR was merged. It cannot mean
# "the upstream is gone": a squash merge never makes the branch's commits
# reachable from the default branch, so locally an abandoned branch and a
# squash-merged one look identical — both simply lose their remote. Deleting on
# a gone upstream alone therefore throws away the only copy of unmerged work,
# which is why every deletion below needs positive proof of a merge — and the
# proof has to cover the local tip: the merged PR's head is the tip, or contains
# it.
#
# The forge CLI is picked by asking which one is authenticated for origin's
# host, so github.com, gitlab.com, GitHub Enterprise and a self-hosted GitLab
# all resolve without special-casing any domain. A Forgejo or Gitea host has
# no CLI, so it is asked over its REST API, and only once the developer names
# a token for it: prune-dead.<url>.giteaTokenFile, matched against
# https://<host> like any git http.<url>.* key. No authenticated CLI, an
# unreachable forge, or a PR that was closed without merging → the branch is
# kept and the reason printed. Never deleted either: the current branch and the
# repository's default branch.
#
# The one local proof is still honoured: worktree-agent-* leftovers actually
# merged into the default branch are deleted without asking the forge.
#
# Invoke as `git prune-dead` — git resolves any `git-*` on PATH as a subcommand.
set -u

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
	echo "git-prune-dead: not inside a git repository" >&2
	exit 1
}

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

# Host and owner/repo of origin, from either URL form: scheme://[user@]host/path
# or the scp shorthand [user@]host:path. The repo is passed to the forge CLI
# explicitly, because gh otherwise resolves its own repo from whichever remote
# it prefers (an `upstream` on a fork clone) — a different repository from the
# one whose host we just checked for a session.
origin_url=$(git remote get-url origin 2>/dev/null || true)
# git reads the scp shorthand only when a colon comes before any slash; any
# other URL without a scheme is a local path, with no host and no forge to ask.
host=
slug=
case $origin_url in
*://*) url_form=scheme ;;
*) case ${origin_url%%/*} in
	*:*) url_form=scp ;;
	*) url_form=local ;;
	esac ;;
esac
if [ "$url_form" != local ]; then
	bare_url=$(printf '%s\n' "$origin_url" |
		sed -e 's#^[A-Za-z0-9+.-]*://##' -e 's#^[^/@]*@##')
	# A bracketed IPv6 literal keeps its colons; any other host ends at the
	# first ":" or "/".
	case $bare_url in
	'['*) host="${bare_url%%]*}]" ;;
	*) host=$(printf '%s\n' "$bare_url" | sed 's#[:/].*$##') ;;
	esac
	# After the host: the scheme form may carry a :port before its first "/";
	# the scp form has no port, just the ":". Leading and trailing slashes and
	# a .git suffix spell the same repository.
	rest=${bare_url#"$host"}
	case $url_form in
	scheme) rest=${rest#*/} ;;
	scp) rest=${rest#:} ;;
	esac
	slug=$(printf '%s\n' "$rest" | sed -e 's#^/*##' -e 's#/*$##' -e 's#\.git$##')
fi

# The forge CLI is whichever one holds a session for that host — the question
# "which forge is this?" and "can I ask it anything?" have the same answer, so
# they are resolved together, once, rather than per branch.
forge=
gitea_token_file=
if [ -n "$host" ]; then
	for cli in gh glab; do
		if command -v "$cli" >/dev/null 2>&1 &&
			"$cli" auth status --hostname "$host" >/dev/null 2>&1; then
			forge=$cli
			break
		fi
	done
	# A configured token file is the Forgejo/Gitea counterpart of a logged-in
	# CLI. The CA is what git itself would trust: GIT_SSL_CAINFO, else
	# http.<url>.sslCAInfo.
	if [ -z "$forge" ]; then
		# The API base: an https origin's own host[:port], else https://<host>.
		# shortcut: an ssh origin assumes the web UI on port 443 at the root, no
		# subpath; give the base its own key if an instance ever serves elsewhere.
		case $origin_url in
		https://*) gitea_base="https://${bare_url%%/*}" ;;
		*) gitea_base="https://$host" ;;
		esac
		gitea_token_file=$(git config --type=path --get-urlmatch prune-dead.giteaTokenFile "$gitea_base" 2>/dev/null || true)
		if [ -n "$gitea_token_file" ] && [ -r "$gitea_token_file" ] &&
			command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
			forge=gitea
			gitea_ca=${GIT_SSL_CAINFO:-$(git config --type=path --get-urlmatch http.sslCAInfo "$gitea_base" 2>/dev/null || true)}
		fi
	fi
fi

# gitea_get <path below /api/v1> — the token goes through curl's stdin config,
# never argv, where any process listing would show it. A CRLF token file
# would otherwise end the header with a stray \r.
gitea_get() {
	printf 'header = "Authorization: token %s"\n' "$(tr -d '\r\n' <"$gitea_token_file")" |
		curl -fsS --max-time 20 -K - ${gitea_ca:+--cacert "$gitea_ca"} \
			"$gitea_base/api/v1/$1" 2>/dev/null
}

# The Gitea API cannot filter pulls by head branch, so the closed ones are
# listed once, newest first, and every branch is matched against that list.
# shortcut: only gitea_pages pages of gitea_per_page closed PRs are read (fewer
# if the server caps the page size lower); an older merge reads as "no merged
# PR" and its branch is kept — page further if a repository ever needs it.
gitea_pages=20
gitea_per_page=50
gitea_pulls=
gitea_listed=
gitea_list() {
	gitea_listed=1
	page=1
	while [ "$page" -le "$gitea_pages" ]; do
		body=$(gitea_get "repos/$slug/pulls?state=closed&sort=recentupdate&limit=$gitea_per_page&page=$page") || {
			gitea_listed=failed
			return
		}
		[ "$(printf '%s' "$body" | tr -d ' \n\r\t')" = "[]" ] && return
		gitea_pulls="$gitea_pulls$body
"
		page=$((page + 1))
	done
}

# merge_state <branch> — 0 merged with the local tip covered, 1 no merged PR,
# 2 could not tell, 3 merged but the local tip is not covered, 4 a merged PR
# came back without a head, so whether it covers the tip is unknown. Both
# CLIs answer with a JSON array of the merged heads, so "[]" is the one shape
# that means "no match"; anything else, including a failure, must never be
# read as "not merged".
#
# A merged PR proves that its head was merged, not that the local branch was:
# commits made after the merge, or a name reused after an older merged PR,
# leave a tip the merge never saw. So the tip must be a merged head or an
# ancestor of one (more was pushed to the PR from elsewhere): every local commit
# is then part of what was merged. A head absent locally and different from
# the tip matches nothing, and is never fetched — not even lazily, by a partial
# clone's promisor remote. A merged PR whose answer has no head proves nothing
# either way — it might be the one that covers the tip — so when no head
# covers it and any PR came back headless, the state is unverified (4), told
# apart from a forge that could not answer at all (2).
#
# Both filters exist to reject a merge that happened on a *fork*: neither CLI
# scopes its branch filter to the head repository, so `--head fix` on a fork
# workflow matches a stranger's same-named branch — measured on cli/cli, where
# one branch name returned merged PRs from 30 different owners. Taking that as
# proof would force-delete local work, the exact failure this script prevents.
# Each filter is written to exclude rather than include, so a field the forge
# stops sending drops the branch out of the merged set instead of into it.
merge_state() {
	case "$forge" in
	gh) out=$(gh pr list --repo "$slug" --head "$1" --state merged \
		--json headRefOid,isCrossRepository \
		--jq '[.[] | select(.isCrossRepository == false) | .headRefOid]' 2>/dev/null) || return 2 ;;
	glab) out=$(glab mr list --repo "$slug" --source-branch "$1" --merged --output json \
		--jq '[.[] | select(.source_project_id != null and .source_project_id == .project_id) | .sha]' 2>/dev/null) || return 2 ;;
	# Once the head branch is deleted Forgejo reports head.ref as
	# refs/pull/<n>/head, leaving the branch name in head.label — which a fork's
	# PR spells owner:branch, so the label alone already excludes forks.
	gitea)
		[ -n "$gitea_listed" ] || gitea_list
		[ "$gitea_listed" = failed ] && return 2
		out=$(printf '%s' "$gitea_pulls" | jq -sc --arg b "$1" \
			'[.[][] | select(.merged == true and (.head.ref == $b or .head.label == $b) and .head.repo_id != null and .head.repo_id == .base.repo_id) | .head.sha]' 2>/dev/null) || return 2 ;;
	*) return 2 ;;
	esac
	case "$(printf '%s' "$out" | tr -d ' \n\r\t')" in
	"" | "[]") return 1 ;;
	esac
	# Fails only if the branch vanished since for-each-ref listed it: nothing
	# left to delete, so the catch-all "unverified" is as far as it goes.
	tip=$(git rev-parse --verify --quiet "refs/heads/$1") || return 2
	heads=$(printf '%s' "$out" | grep -oE '[0-9a-f]{40,64}') || return 4
	for head in $heads; do
		[ "$head" = "$tip" ] && return 0
		GIT_NO_LAZY_FETCH=1 git merge-base --is-ancestor "$tip" "$head" 2>/dev/null && return 0
	done
	case "$out" in
	*null* | *'""'*) return 4 ;;
	esac
	return 3
}

delete_branch() {
	# Skip the default and current branches; tolerate a refusal (e.g. the
	# branch is checked out in another worktree) without aborting the run.
	[ "$1" = "$default" ] && return 0
	[ "$1" = "$current" ] && return 0
	if git branch -D "$1" >/dev/null 2>&1; then
		echo "  deleted $1"
	fi
}

if [ -n "$(git remote)" ]; then
	echo "git-prune-dead: fetching + pruning remote refs..."
	# stderr is left alone: a failed prune is exactly what stops upstreams from
	# reading [gone], so the reason has to reach the user.
	git fetch --prune --quiet ||
		echo "git-prune-dead: fetch failed — working from the refs already local"
else
	echo "git-prune-dead: no remote configured — skipping fetch"
fi

# Default branch from origin/HEAD (set by `git remote set-head`), read only
# after the fetch: its --prune can remove the branch origin/HEAD names, and
# set-head alone refreshes the symref. The default is a local branch name,
# the one the guards below compare against. When origin/HEAD is unset,
# dangling or names no local branch, fall back to whichever of main/master
# exists locally, then to the current branch — so we never compare against a
# non-existent ref. merged_into is what the worktree-agent-* sweep measures
# against: the remote default itself when only origin has it, else the local
# default.
default=
merged_into=
if git rev-parse --verify --quiet refs/remotes/origin/HEAD >/dev/null; then
	default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
	if ! git show-ref --verify --quiet "refs/heads/$default"; then
		merged_into=refs/remotes/origin/HEAD
		default=
	fi
fi
if [ -z "$default" ]; then
	for cand in main master; do
		if git show-ref --verify --quiet "refs/heads/$cand"; then
			default=$cand
			break
		fi
	done
fi
[ -n "$default" ] || default=$current
[ -n "$merged_into" ] || merged_into=$default

if [ -n "$forge" ]; then
	echo "git-prune-dead: removing branches merged according to $forge on $host..."
elif [ -n "$origin_url" ] && [ -z "$host" ]; then
	echo "git-prune-dead: origin is a local path — no forge to ask, keeping every branch"
elif [ -n "$gitea_token_file" ]; then
	echo "git-prune-dead: a giteaTokenFile is set for '$host', but $gitea_token_file is unreadable or curl/jq is missing — keeping every branch"
else
	echo "git-prune-dead: no CLI logged in to '${host:-no remote}' — keeping every branch"
	echo "  a gone upstream does not prove a merge; log in with: gh auth login --hostname ${host:-HOST}"
	echo "  or, on a GitLab instance: glab auth login --hostname ${host:-HOST}"
	echo "  or, on a Forgejo/Gitea instance: git config --global prune-dead.https://${host:-HOST}.giteaTokenFile <token file>"
fi

git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/ |
	while read -r name track; do
		[ "$track" = "[gone]" ] || continue
		[ "$name" = "$default" ] && continue
		[ "$name" = "$current" ] && continue
		merge_state "$name"
		case $? in
		0) delete_branch "$name" ;;
		1) echo "  kept $name (no merged PR on $forge — closed, or never opened)" ;;
		3) echo "  kept $name (no merged PR on $forge contains its tip — commits after the merge, a reused name, or a merged head not fetched here)" ;;
		4) echo "  kept $name (merge state unverified — a merged PR on $forge reports no head)" ;;
		# Named even with no forge to ask: a branch that survives silently reads
		# as one that was pruned.
		*) echo "  kept $name (merge state unverified${forge:+ — $forge could not answer})" ;;
		esac
	done

# Only meaningful when a default branch could be resolved; skip otherwise so
# we never run `git branch --merged ''`.
if [ -n "$merged_into" ]; then
	echo "git-prune-dead: removing merged worktree-agent-* leftovers..."
	git branch --merged "$merged_into" --format='%(refname:short)' |
		grep '^worktree-agent-' |
		while read -r name; do
			delete_branch "$name"
		done
fi

git worktree prune

kept="kept $default"
[ -n "$current" ] && [ "$current" != "$default" ] && kept="$kept, current $current"
echo "git-prune-dead: done ($kept)"
