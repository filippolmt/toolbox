#!/bin/sh
# toolbox bridge wrapper. Replaces xdg-open inside the container so
# every CLI that opens a URL (gh, claude, codex, etc.) hands it to the host
# daemon over host.docker.internal. Falls back silently to stderr when the
# daemon is not installed or unreachable so callers never block.

set -eu

. /usr/local/lib/toolbox/bridge-lib.sh

URL="${1:-}"
if [ -z "${URL}" ]; then
    echo "xdg-open: missing URL" >&2
    exit 0
fi

if ! bridge_ready; then
    case "${BRIDGE_ERROR}" in
    not_installed) echo "xdg-open: bridge not installed — run 'toolbox bridge install' on the host; URL:" >&2 ;;
    *) echo "xdg-open: curl missing in image; URL:" >&2 ;;
    esac
    echo "${URL}" >&2
    exit 0
fi

PAYLOAD=$(printf '{"url":%s}' "$(printf '%s' "${URL}" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')")

STATUS=$(bridge_post /open "${PAYLOAD}" /dev/null 5)
case "${STATUS}" in
2??) ;;
*)
    echo "xdg-open: bridge unreachable — check 'toolbox bridge status' on the host; URL:" >&2
    echo "${URL}" >&2
    ;;
esac
exit 0
