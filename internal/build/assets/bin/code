#!/bin/sh
# toolbox browser-bridge editor shim. Shadows `code`/`codium` inside the
# container (editor inferred from basename): resolves each path argument,
# translates the /workspace prefix to the host path from
# TOOLBOX_HOST_WORKSPACE, and POSTs it to the host daemon's /edit endpoint
# so the host editor opens it. Unlike xdg-open (exit 0 so OAuth flows never
# block), this is an interactive command — failures exit non-zero.

set -eu

. /usr/local/lib/toolbox/bridge-lib.sh

WORKSPACE="/workspace"

EDITOR_NAME="$(basename "$0")"

if ! bridge_ready; then
    case "${BRIDGE_ERROR}" in
    not_installed) echo "${EDITOR_NAME}: bridge not installed — run 'toolbox browser-bridge install' on the host" >&2 ;;
    *) echo "${EDITOR_NAME}: curl missing in image" >&2 ;;
    esac
    exit 1
fi

if [ -z "${TOOLBOX_HOST_WORKSPACE:-}" ]; then
    echo "${EDITOR_NAME}: TOOLBOX_HOST_WORKSPACE not set — cannot map ${WORKSPACE} to a host path" >&2
    exit 1
fi

# No args → open the current directory.
[ "$#" -eq 0 ] && set -- .

# Pass 1: validate every argument and translate it to a host path before
# sending anything (all-or-nothing). Translated paths are appended to the
# positional params; the shift below drops the original arguments.
NARGS=$#
for ARG in "$@"; do
    case "${ARG}" in
    -*)
        echo "${EDITOR_NAME}: flags not supported by the toolbox shim: ${ARG}" >&2
        exit 1
        ;;
    esac
    ABS="$(realpath -m -- "${ARG}")"
    case "${ABS}" in
    "${WORKSPACE}" | "${WORKSPACE}"/*) ;;
    *)
        echo "${EDITOR_NAME}: ${ARG} is outside ${WORKSPACE} — host cannot see it" >&2
        exit 1
        ;;
    esac
    set -- "$@" "${TOOLBOX_HOST_WORKSPACE}${ABS#"${WORKSPACE}"}"
done
shift "${NARGS}"

# Pass 2: POST, one request per path.
for HOST_PATH in "$@"; do
    PAYLOAD=$(EDITOR_NAME="${EDITOR_NAME}" HOST_PATH="${HOST_PATH}" python3 -c \
        'import json, os; print(json.dumps({"editor": os.environ["EDITOR_NAME"], "path": os.environ["HOST_PATH"]}))')

    STATUS=$(bridge_post /edit "${PAYLOAD}" /dev/null 5)

    case "${STATUS}" in
    2??) ;;
    404)
        echo "${EDITOR_NAME}: host daemon has no /edit endpoint — update the host toolbox CLI to support editor opens" >&2
        exit 1
        ;;
    000)
        echo "${EDITOR_NAME}: bridge unreachable — check 'toolbox browser-bridge status' on the host" >&2
        exit 1
        ;;
    *)
        echo "${EDITOR_NAME}: bridge rejected ${HOST_PATH} (HTTP ${STATUS}) — check 'toolbox browser-bridge status' on the host" >&2
        exit 1
        ;;
    esac
done
