{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "/usr/local/bin/wt config state marker set 🤖 >/dev/null 2>&1 || true"}]}
    ],
    "PermissionRequest": [
      {"matcher": "", "hooks": [{"type": "command", "command": "/usr/local/bin/wt config state marker set 💬 >/dev/null 2>&1 || true"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "/usr/local/bin/wt config state marker set 💬 >/dev/null 2>&1 || true"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "/usr/local/bin/wt config state marker clear >/dev/null 2>&1 || true", "timeout": 3}]}
    ]
  }
}
