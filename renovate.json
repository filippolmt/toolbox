      "matchStrings": ["ARG\\s+SHELLCHECK_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "koalaman/shellcheck",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+SHFMT_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "mvdan/sh",
      "extractVersionTemplate": "^v(?<version>.*)$"
