      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "rtk-ai/rtk",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/sdd/registry\\.go$/"],
      "matchStrings": [
        "NpmPackage:\\s*\"@opengsd/gsd-core\"[^}]*?Version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@opengsd/gsd-core",
      "packageNameTemplate": "@opengsd/gsd-core"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/sdd/registry\\.go$/"],
      "matchStrings": [
        "NpmPackage:\\s*\"bmad-method\"[^}]*?Version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "bmad-method",
      "packageNameTemplate": "bmad-method"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/sdd/registry\\.go$/"],
      "matchStrings": [
        "NpmPackage:\\s*\"@fission-ai/openspec\"[^}]*?Version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@fission-ai/openspec",
      "packageNameTemplate": "@fission-ai/openspec"
    },
    {
      "description": "The golang image tag for the containerised Go test/lint/build targets. Kept on the docker datasource, NOT derived from go.mod's toolchain directive: Docker Hub publishes golang:<patch> days after the Go release reaches the index, so a derived tag lets an automergeable gomod bump land a tag that does not exist yet.",
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GO_IMAGE_VERSION\\s*:?=\\s*(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "golang"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GOLANGCI_VERSION\\s*:?=\\s*(?<currentValue>v\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["RENOVATE_VERSION:\\s+(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "packageNameTemplate": "renovate"
    }
