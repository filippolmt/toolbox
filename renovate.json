{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "timezone": "Europe/Rome",
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group every update — including major — into a single PR and auto-merge it as soon as CI is green. platformAutomerge true uses GitHub native auto-merge: the PR merges the moment required status checks pass, no time window. Requires branch protection on main with the CI workflow set as a required check.",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Runtime image (Dockerfile) deps get their own PR, split out of the catch-all group above (later rule wins on groupName). Schedule/automerge are inherited from the catch-all. The Go version is NOT here — it lives in go.mod's toolchain directive and reaches the image as a GO_VERSION build-arg naming a go.dev tarball. The golang *Docker image* used by the Makefile's test container is pinned separately (GO_IMAGE_VERSION), because Docker Hub publishes that tag later than the release.",
      "matchFileNames": ["internal/build/assets/Dockerfile"],
      "groupName": "dockerfile image",
      "groupSlug": "dockerfile"
    },
    {
      "description": "Best-effort hardening: pin the public Go proxy for the moby monorepo submodules (github.com/moby/moby/client + /api). These modules resolve correctly on proxy.golang.org; the dashboard 'no-result' is a transient gomod lookup flake, and forcing the known-good proxy makes lookups more deterministic. Not a guaranteed fix.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/moby/moby/client", "github.com/moby/moby/api"],
      "registryUrls": ["https://proxy.golang.org"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GH_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cli/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GLAB_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "gitlab-releases",
      "packageNameTemplate": "gitlab-org/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GWS_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "googleworkspace/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
