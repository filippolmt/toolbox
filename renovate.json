{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "timezone": "Europe/Rome",
  "platformAutomerge": false,
  "automergeSchedule": ["* 6-9 * * *"],
  "updateNotScheduled": false,
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Group every update — including major — into a single PR. Branch updates only 23:00–05:00 (updateNotScheduled false) so CI is green before the 06:00–09:59 automerge window; platformAutomerge stays false (3b8d5f7: native auto-merge ignores automergeSchedule).",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "schedule": ["after 11pm", "before 5am"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Runtime image (Dockerfile) deps get their own PR, split out of the catch-all group above (later rule wins on groupName). Schedule/automerge are inherited from the catch-all. The Go version is NOT here — it lives in go.mod's toolchain directive (single source of truth) and the image derives it via a GO_VERSION build-arg.",
      "matchFileNames": ["internal/build/assets/Dockerfile"],
      "groupName": "dockerfile image",
      "groupSlug": "dockerfile"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GH_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cli/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GLAB_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "gitlab-releases",
      "packageNameTemplate": "gitlab-org/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GWS_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "googleworkspace/cli",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+ATUIN_VERSION=(?<currentValue>\\S+)"],
