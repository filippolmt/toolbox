      "depNameTemplate": "zsh-users/zsh-autosuggestions",
      "packageNameTemplate": "https://github.com/zsh-users/zsh-autosuggestions",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+ZSH_SYNTAX_HIGHLIGHTING_COMMIT=(?<currentDigest>[a-f0-9]{40})"],
