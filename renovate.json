      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+FZF_TAB_COMMIT=(?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "master",
      "depNameTemplate": "Aloxaf/fzf-tab",
      "packageNameTemplate": "https://github.com/Aloxaf/fzf-tab",
