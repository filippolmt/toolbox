    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GCLOUD_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "google/cloud-sdk",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
