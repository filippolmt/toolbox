    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GOPLS_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "go",
      "packageNameTemplate": "golang.org/x/tools/gopls",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/build/assets/Dockerfile$/"],
      "matchStrings": ["ARG\\s+GOIMPORTS_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "go",
      "packageNameTemplate": "golang.org/x/tools",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
